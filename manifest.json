{
  "manifest_version": 3,
  "name": "Page Key & Mouse Blocker",
  "version": "1.1.0",
  "description": "Prevent accidental keyboard and mouse navigation on selected pages while keeping Backspace available for typing.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Page Key & Mouse Blocker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
